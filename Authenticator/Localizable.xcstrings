    "Clear passwords saved on this device. This will prompt for a password next time a password protected YubiKey is used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche die auf diesem Gerät gespeicherten Passwörter. Dadurch wirst Du bei der nächsten Verwendung eines passwortgeschützten YubiKeys nach dem dazugehörigen Passwort gefragt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les mots de passe enregistrés sur ce dispositif. Un mot de passe sera demandé lors de la prochaine utilisation d'une YubiKey protégée par un mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存しているパスワードを消去します。これにより、パスワードで保護されたYubiKeyを次に使用する際にパスワードの入力を求められます。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyčistiť heslá uložené v tomto zariadení. Pri ďalšom použití heslom chráneného kľúča YubiKey sa zobrazí výzva na zadanie hesla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除在此设备上保存的密码,下次使用受密码保护的 YubiKey 时将提示输入密码."
          }
        }
      }
