        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey už nemá miesto na úložisku pre účty OATH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey 上已无存储空间存放 OATH 账户."
          }
        }
      }
    },
    "The YubiKey is not connected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein YubiKey verbunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le YubiKey n'est pas connecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKeyが接続されていません。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey nie je pripojený."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey 未连接."
          }
        }
      }
    },
    "There's already an account named": {
      "comment": "OATH substring in 'There's already an account named [issuer, name] on this YubiKey.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bereits ein Konto namens"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il existe déjà un compte portant le nom de"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このYubikeyには"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už existuje účet s názvom"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在名为以下名称的账户"
          }
        }
      }
    },
    "These certificates have been added to this": {
      "comment": "PIV extension substring in 'These certificates have been added to this [iPad/iPhone] and can be used by other applications'",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zertifikate wurden hinzugefügt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces certificats ont été ajoutés à cette clé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "に追加されていて、他のアプリケーションからも使用できます"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto certifikáty boli pridané do tohto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些证书已添加到本设备"
          }
        }
      }
    },
    "These certificates have been added to this %@ and can be used by other applications.": {
      "comment": "PIV extension certs on device",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zertifikate wurden zu Deinem %@ hinzugefügt und können von anderen Applikationen verwendet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces certificats ont été ajoutés à ce site %@ et peuvent être utilisés par d'autres applications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの証明書はこの%@に追加されていて、他のアプリケーションからも使用できます。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto certifikáty boli pridané na tento %@ a môžu ich používať iné aplikácie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些证书已添加到 %@,可供其它应用使用."
          }
        }
      }
    },
    "This operation is not supported over Lightning on this YubiKey. Please use Yubico Authenticator for desktop to reset the FIDO application.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Vorgang wird bei diesem YubiKey nicht über Lightning unterstützt. Bitte verwenden die Desktop Version des Yubico Authenticator, um die FIDO-Anwendung zurückzusetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette opération n'est pas supportée par Lightning sur cette YubiKey. Veuillez utiliser Yubico Authenticator for desktop pour réinitialiser l'application FIDO."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本YubiKeyでは、Lightning経由でのこの操作はサポートされていません。FIDOアプリケーションをリセットするには、Yubico Authenticator for desktopをご利用ください。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto operácia nie je podporovaná cez Lightning na tomto YubiKey. Na obnovenie aplikácie FIDO použite Yubico Authenticator pre počítač."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 YubiKey 不支持通过 Lightning 执行此操作,请使用桌面版 Yubico Authenticator 重置 FIDO 应用."
          }
        }
      }
    },
    "This QR code is not supported": {
      "comment": "Invalid Uri format, not OATH URL",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR-Code wird nicht unterstützt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code QR non pris en charge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このQRコードはサポートされていません"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento QR kód nie je podporovaný"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此二维码不受支持"
          }
        }
      }
    },
    "This setting is not supported on your YubiKey.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellung wird von Deinem YubiKey nicht unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paramètre n'est pas pris en charge par votre YubiKey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定はYubiKeyではサポートされていません。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nastavenie nie je na vašom YubiKey podporované."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设置在你的 YubiKey 上不受支持."
          }
        }
      }
    },
    "This translation is a community effort, please visit [crowdin.com](https://crowdin.com/project/yubico-authenticator-ios) to contribute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Übersetzung ist eine Gemeinschaftsarbeit, bitte besuche [crowdin.com](https://crowdin.com/project/yubico-authenticator-ios), um beizutragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette traduction est le fruit d'un effort communautaire, veuillez visiter [crowdin.com](https://crowdin.com/project/yubico-authenticator-ios) pour y contribuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この翻訳はコミュニティーの努力の賜物です。[crowdin.com](https://crowdin.com/project/yubico-authenticator-ios)にアクセスして貢献してください。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento preklad je výsledkom komunity, ak chcete prispieť, navštívte stránku [crowdin.com](https://crowdin.com/project/yubico-authenticator-ios)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本翻译由社区贡献,请访问 [crowdin.com](https://crowdin.com/project/yubico-authenticator-ios) 参与."
          }
        }
      }
    },
    "This version of iOS does not support operations with the YubiKey for Lightning nor over NFC": {
      "comment": "Not supported",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von iOS unterstützt keine Operationen mit dem YubiKey über Lightning oder NFC"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d'iOS ne prend pas en charge les opérations avec YubiKey pour Lightning ni via NFC"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのiOSでは、LightningやNFCでのYubiKeyを使用した操作はサポートされていません"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto verzia iOS nepodporuje operácie s YubiKey cez Lightning ani cez NFC"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 iOS 版本不支持通过 Lightning 或 NFC 操作 YubiKey"
          }
        }
      }
    },
    "This will irrevocably delete all OATH TOTP/HOTP accounts from your YubiKey.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle OATH TOTP/HOTP-Konten unwiderruflich von Deinem YubiKey gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera définitivement tous les comptes OATH TOTP/HOTP de votre YubiKey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、すべてのOATH TOTP/HOTPアカウントがYubiKeyから削除されます。削除は取り消すことができません。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tým sa z vášho YubiKey nenávratne vymažú všetky účty OATH TOTP/HOTP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将不可撤销地删除 YubiKey 上全部 OATH TOTP/HOTP 账户."
          }
        }
      }
    },
    "This will irrevocably delete all U2F and FIDO2 accounts, including passkeys, from your YubiKey.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle U2F- und FIDO2-Konten, einschließlich der Passkeys, unwiderruflich von Deinem YubiKey gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera irrévocablement tous les comptes U2F et FIDO2, y compris les passkeys, de votre YubiKey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告！これにより、すべてのU2FおよびFIDO2アカウントがパスキーを含めてYubiKeyから削除されます。削除は取り消すことができません。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tým sa z vášho YubiKey nenávratne odstránia všetky účty U2F a FIDO2 vrátane prístupových kľúčov."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将不可撤销地删除 YubiKey 上全部 U2F 和 FIDO2 账户,包括通行密钥."
          }
        }
      }
    },
    "This will permanently delete the account from the YubiKey, and your ability to generate codes for it!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Konto dauerhaft aus dem YubiKey gelöscht. Du wirst keine Codes mehr generieren können!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera définitivement le compte de la YubiKey et vous ne pourrez plus générer de codes!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、YubiKeyからアカウントが完全に削除され、コードを生成できなくなります!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa účet natrvalo odstráni z YubiKey a vaša možnosť generovať preň kódy!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将从 YubiKey 上永久删除该账户,以及为其生成验证码的能力!"
          }
        }
      }
    },
    "This YubiKey has Yubico OTP enabled which makes it appear as an external keyboard to the iPhone. Unfortunately this causes problem with the normal on-screen keyboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses YubiKey hat Yubico OTP aktiviert, was ihn als externe Tastatur für das iPhone erscheinen lässt. Leider verursacht dies Probleme mit der normalen Bildschirmtastatur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yubico OTP étant activé, cette YubiKey apparaît comme clavier externe pour l'iPhone. Cela pose problème avec le clavier à l'écran normal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このYubiKeyはYubico OTPが有効になっているため、iPhoneへの外付けキーボードとして表示されます。これが原因で、標準のオンスクリーンキーボードで問題が発生します。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kľúč YubiKey má aktivovanú funkciu Yubico OTP, vďaka ktorej sa javí ako externá klávesnica pre iPhone. Bohužiaľ to spôsobuje problém s normálnou klávesnicou na obrazovke."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 YubiKey 已启用 Yubico OTP,对 iPhone 表现为外接键盘,这会影响正常屏幕键盘."
          }
        }
      }
    },
    "To add an account to a FIPS key, you must first set a password for the OATH application.": {
      "comment": "Error message when trying to add and OATH account to a FIPS key without a password.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ein Konto zu einem FIPS-Schlüssel hinzuzufügen, musst Du zunächst ein Passwort für die OATH-Anwendung festlegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter un compte à une clé FIPS, vous devez d'abord définir un mot de passe pour l'application OATH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FIPS キーにアカウントを追加する場合、先に OATH アプリケーションにパスワードを設定してください。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete pridať účet do FIPS kľúča, musíte najprv nastaviť heslo pre aplikáciu OATH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要向 FIPS 密钥添加账户,必须先为 OATH 应用设置密码."
          }
        }
      }
    },
    "To prevent unauthorized access the FIDO application can be protected by a PIN.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um unbefugten Zugriff zu verhindern, kann die FIDO-Anwendung durch eine PIN geschützt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour éviter tout accès non autorisé, l'application FIDO peut être protégée par un code PIN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FIDOアプリケーションをPINで保護して、不正なアクセスを防ぐことができます。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sa zabránilo neoprávnenému prístupu, aplikácia FIDO môže byť chránená PIN kódom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为防止未授权访问,FIDO 应用可用 PIN 保护."
          }
        }
      }
    },
    "To prevent unauthorized access the OATH application can be protected by a password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um unbefugten Zugriff zu verhindern, kann die OATH-Anwendung durch ein Passwort geschützt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour empêcher tout accès non autorisé, l'application OATH peut être protégée par un mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OATHアプリケーションをパスワードで保護して、不正なアクセスを防ぐことができます。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sa zabránilo neoprávnenému prístupu, aplikácia OATH môže byť chránená heslom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为防止未授权访问,OATH 应用可用密码保护."
          }
        }
      }
    },
    "To prevent unauthorized access this YubiKey is protected with a password.": {
      "comment": "OATH password entry enter password",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um unbefugten Zugriff zu verhindern, ist dieser YubiKey mit einem Passwort geschützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour empêcher tout accès non autorisé, cette YubiKey est protégée par un mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この YubiKey は不正なアクセスからパスワードで保護されています。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sa zabránilo neoprávnenému prístupu, je tento kľúč YubiKey chránený heslom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为防止未授权访问,此 YubiKey 已设置密码保护."
          }
        }
      }
    },
    "To scan a QR code you need to enable camera permissions for the Authenticator app.": {
      "comment": "Scan QR code camera error message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen QR-Code zu scannen, musst Du Zugriffsrechte zur Kameranutzung für die Authenticator-App aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour scanner un code QR, vous devez activer les autorisations de caméra pour l'application Authenticator."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードをスキャンするには、Authenticatorアプリのカメラ権限を有効にする必要があります。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete naskenovať QR kód, musíte zapnúť povolenia kamery pre aplikáciu Authenticator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描二维码需要为 Authenticator 应用开启相机权限."
          }
        }
      }
    },
    "Toggle One-Time Password": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "One-Time Password Einstellungen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculer le mot de passe à usage unique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタイムパスワードの切り替え"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepnúť jednorazové heslo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换一次性验证码"
          }
        }
      }
    },
    "Touch key time out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung um Deinen YubiKey zu beühren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d'attente de la touche tactile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチキータイムアウト。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Časový limit dotykového tlačidla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触摸密钥超时."
          }
        }
      }
    },
    "Touch the button on the YubiKey now.": {
      "comment": "FIDO reset view",
      "localizations": {
        "de": {
