    "Certificates on this YubiKey can be used to authenticate and sign requests from other applications if added to this": {
      "comment": "PIV extension no certs on yubikey message",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikate auf diesem YubiKey können dazu verwendet werden, um Anfragen von anderen Anwendungen zu authentifizieren und zu signieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les certificats sur cette YubiKey peuvent être utilisés pour authentifier et signer des requêtes provenant d'autres applications s'ils sont ajoutés à celle-ci"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このYubiKeyの証明書を使用して、他のアプリケーションからのリクエストが追加された場合に認証して署名することができます"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikáty na tomto kľúči YubiKey možno použiť na overovanie a podpisovanie požiadaviek z iných aplikácií, ak sa pridajú do tohto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 YubiKey 上的证书添加到本设备后,可用于对其它应用的请求进行身份验证和签名"
          }
        }
      }
    },
    "Certificates on this YubiKey can be used to authenticate and sign requests from other applications if added to this %@.": {
      "comment": "PIV extension no certs on yubikey message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zertifikate auf diesem YubiKey können verwendet werden, um Anfragen von anderen Anwendungen zu authentifizieren und zu signieren, wenn sie zu diesem %@ hinzugefügt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les certificats de cette YubiKey peuvent être utilisés pour authentifier et signer les demandes d'autres applications si elles sont ajoutées à ce site %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey上の証明書をこの%@に追加すると、他のアプリケーションからの認証や署名のリクエストに対して使用できるようになります。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikáty na tomto YubiKey možno použiť na overovanie a podpisovanie požiadaviek z iných aplikácií, ak sa pridajú do tohto %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 YubiKey 上的证书添加到 %@ 后,可用于对其它应用的请求进行身份验证和签名."
          }
        }
      }
    },
